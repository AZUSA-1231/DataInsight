# DataInsight LLM Configuration
# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit your API key.

DATAINSIGHT_LLM_MODEL=deepseek-v4-flash
DATAINSIGHT_LLM_API_KEY=sk-xxxxxxxxxxxxx
DATAINSIGHT_LLM_BASE_URL=https://api.deepseek.com/v1
DATAINSIGHT_LLM_TEMPERATURE=0

# Optional per-stage model overrides. All fall back to DATAINSIGHT_LLM_MODEL.
# DATAINSIGHT_LLM_MODEL_PLANNER=deepseek-v4-pro
# DATAINSIGHT_LLM_MODEL_ANALYSIS_TRANSFORM=deepseek-v4-flash
# DATAINSIGHT_LLM_MODEL_ANALYSIS_TERMINAL=deepseek-v4-pro
